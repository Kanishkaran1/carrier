# Copy to .env for local development. Never commit .env itself.
#
# NOTE: Vite inlines every VITE_* variable into the public JavaScript bundle at
# build time. They are visible to anyone who views source — do not put a real
# secret here. Set the same variables in the Vercel dashboard under
# Settings > Environment Variables.

# --- EmailJS (required: the contact form silently fails without these) -------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Site URL (required for SEO: sitemap.xml, canonical + og:image) ----------
# Your production origin, no trailing slash. Example: https://www.example.com
VITE_SITE_URL=
